# ============================================================
# AgentShield — Environment Configuration Example
# Copy to .env and fill in values before running.
# NEVER commit the real .env file.
# ============================================================

# ----- Database -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agentshield:agentshield@localhost:5432/agentshield

# ----- Redis ----------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- Ed25519 Keys (PEM-encoded, base64 lines joined) ----------
# Generate with:
#   python -c "
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, PublicFormat, NoEncryption
#   k = Ed25519PrivateKey.generate()
#   print('AGENTSHIELD_SIGNING_KEY_PEM=' + k.private_bytes(Encoding.PEM, PrivateFormat.PKCS8, NoEncryption()).decode().replace('\n','\\n'))
#   print('AGENTSHIELD_VERIFYING_KEY_PEM=' + k.public_key().public_bytes(Encoding.PEM, PublicFormat.SubjectPublicKeyInfo).decode().replace('\n','\\n'))
#   "
AGENTSHIELD_SIGNING_KEY_PEM=
AGENTSHIELD_VERIFYING_KEY_PEM=

# Key identifier embedded in capability JWTs
AGENTSHIELD_KEY_ID=agentshield-key-v1

# Executor identifier — must match the value embedded in issued capabilities
AGENTSHIELD_EXECUTOR_ID=agentshield-executor-v1

# ----- JWT / Capability TTL -------------------------------------
# Default capability TTL in seconds (how long a capability is valid after issuance)
CAPABILITY_TTL_SECONDS=300

# Consumed-capability Redis key TTL (must exceed CAPABILITY_TTL_SECONDS)
CONSUMED_CAPABILITY_TTL_SECONDS=3900

# ----- Human Approval -------------------------------------------
APPROVAL_TTL_SECONDS=1800

# ----- Rate Limiting --------------------------------------------
# Max action submissions per agent per minute
RATE_LIMIT_PER_MINUTE=30

# ----- Admin Authentication (static secret for demo) -----------
ADMIN_SECRET_TOKEN=change-me-in-production

# ----- Application ----------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
