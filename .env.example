# ============================================================
# AgentShield V3 — Environment Configuration
# Copy to .env and fill in values before running.
# NEVER commit the real .env file.
# ============================================================

# ----- Database -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agentshield:agentshield@localhost:5432/agentshield

# ----- Redis ----------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- Ed25519 Keys (PEM-encoded, \n-escaped for .env) ----------
# Generate with the command shown in README.md.
# Both lines must be on a single line with literal \n between PEM lines.
AGENTSHIELD_SIGNING_KEY_PEM=
AGENTSHIELD_VERIFYING_KEY_PEM=

# Key identifier embedded in capability JWTs
AGENTSHIELD_KEY_ID=agentshield-key-v1

# Executor identifier — must match the value embedded in issued capabilities
AGENTSHIELD_EXECUTOR_ID=agentshield-executor-v1

# ----- JWT / Capability TTL -------------------------------------
# Default capability TTL in seconds (how long a capability is valid after issuance)
CAPABILITY_TTL_SECONDS=300

# Consumed-capability Redis key TTL (must exceed CAPABILITY_TTL_SECONDS)
CONSUMED_CAPABILITY_TTL_SECONDS=3900

# ----- Human Approval -------------------------------------------
APPROVAL_TTL_SECONDS=1800

# ----- Rate Limiting --------------------------------------------
# Max action submissions per agent per minute
RATE_LIMIT_PER_MINUTE=30

# ----- Admin Authentication (static secret for demo) -----------
# Change this before running. The CLI reads it from ADMIN_SECRET_TOKEN.
ADMIN_SECRET_TOKEN=change-me-in-production

# ----- CORS origins (comma-separated) ---------------------------
# Add localhost:8501 for the Streamlit dashboard
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501

# ----- Dashboard ------------------------------------------------
# URL the dashboard uses to reach the backend
AGENTSHIELD_API_URL=http://localhost:8000

# ----- Application ----------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ----- OPA (optional) -------------------------------------------
# Set to enable the OPA policy engine as an additive check.
# Leave empty to use only the Python deterministic policy engine.
# OPA_URL=http://localhost:8181
